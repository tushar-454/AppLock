{
  "expo": {
    "name": "AppLock",
    "slug": "AppLock",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/applock.png",
    "scheme": "applock",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F3EDF7",
        "foregroundImage": "./assets/images/applock-foreground.png",
        "monochromeImage": "./assets/images/applock-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.tushar.applock",
      "versionCode": 1,
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.VIBRATE",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFBFE",
          "image": "./assets/images/applock-foreground.png",
          "imageWidth": 76
        }
      ],
      "./plugins/with-app-lock"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "platforms": [
      "android"
    ]
  }
}
